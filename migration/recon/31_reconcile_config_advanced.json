{
  "tables": [
    {
      "source_name": "dim_store",
      "target_name": "dim_store",
      "join_columns": ["store_id"],
      "select_columns": ["store_id", "store_name", "region"]
    },
    {
      "source_name": "dim_product",
      "target_name": "dim_product",
      "join_columns": ["product_id"],
      "transformations": [
        { "column_name": "sku", "source": "sku", "target": "trim(lower(sku))" }
      ],
      "column_thresholds": [
        { "column_name": "unit_price", "lower_bound": "-0.001", "upper_bound": "0.001", "type": "float" }
      ]
    },
    {
      "source_name": "dim_customer",
      "target_name": "dim_customer",
      "join_columns": ["customer_id"],
      "drop_columns": ["updated_ts"],
      "transformations": [
        { "column_name": "email", "source": "coalesce(email, '')", "target": "email" }
      ]
    },
    {
      "source_name": "fact_orders",
      "target_name": "fact_orders",
      "join_columns": ["order_id"],
      "jdbc_reader_options": {
        "number_partitions": 8,
        "partition_column": "order_id",
        "lower_bound": "1",
        "upper_bound": "500",
        "fetch_size": "1000"
      },
      "filters": {
        "source": "order_ts >= '2026-01-01'",
        "target": "order_ts >= '2026-01-01'"
      },
      "table_thresholds": [
        { "lower_bound": "0", "upper_bound": "5", "model": "mismatch" }
      ]
    },
    {
      "source_name": "fact_order_items",
      "target_name": "fact_order_items",
      "join_columns": ["order_item_id"],
      "column_thresholds": [
        { "column_name": "amount", "lower_bound": "-0.005", "upper_bound": "0.005", "type": "float" }
      ]
    },
    {
      "source_name": "agg_daily_sales",
      "target_name": "agg_daily_sales",
      "join_columns": ["store_id", "sales_date"],
      "column_thresholds": [
        { "column_name": "revenue", "lower_bound": "-0.5", "upper_bound": "0.5", "type": "float" }
      ]
    },
    {
      "source_name": "edge_geo",
      "target_name": "edge_geo",
      "join_columns": ["geo_id"],
      "column_mapping": [
        { "source_name": "country", "target_name": "country_name" }
      ],
      "column_thresholds": [
        { "column_name": "lat", "lower_bound": "-0.0001", "upper_bound": "0.0001", "type": "float" }
      ]
    }
  ],
  "version": 2
}
